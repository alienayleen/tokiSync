    {
      "id": "blacktoon_novel",
      "name": "통합 소설 규칙 (신형 v2 & 북토끼/뉴토끼 호환)",
      "_version": "1.26.6",
      "urlPattern": ".*/(novel|book)/.*",
      "idExtraction": {
        "source": "url",
        "regex": "\\/(?:novel|book)\\/([a-zA-Z0-9_\\-]+)"
      },
      "category": "Novel",
      "meta": {
        "title": [
          "div.nd-info > h1",
          "h1.hero-v2-title",
          {
            "selector": "meta[name=\"subject\"]",
