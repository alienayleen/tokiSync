          ".view-title h1",
          ".page-desc",
          {
            "selector": "meta[property=\"og:title\"]",
            "attr": "content"
          }
        ],
        "author": [
          "div.nd-meta span:first-child",
          "div.hero-v2-author",
          {
            "selector": ".view-content",
